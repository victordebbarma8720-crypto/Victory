# ==========================================================
# Chamet Agency India - Hostinger (Apache / LiteSpeed) settings
# ==========================================================

ErrorDocument 404 /404.html
Options -Indexes
DirectoryIndex index.html

# Old addresses from earlier versions of the site -> current pages
<IfModule mod_alias.c>
  RedirectMatch 301 ^/chamet-hosting(\.html|/)?$ /chamet-host.html
  RedirectMatch 301 ^/chamet-agency/$ /chamet-agency.html
  RedirectMatch 301 ^/blog/$ /blog.html
  RedirectMatch 301 ^/(how-to-register-chamet-agency|chamet-agency-commission-explained|chamet-host-registration-guide|chamet-beans-conversion|chamet-payment-withdrawal-guide|chamet-agency-responsibilities|chamet-host-profile-tips)\.html$ /blog.html
</IfModule>

# --- Force HTTPS and non-www ---
# Enable ONLY after the free SSL certificate is active in hPanel > Security > SSL
# (or use hPanel's "Force HTTPS" switch instead). Remove the leading # to enable.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off [OR]
#   RewriteCond %{HTTP_HOST} ^www\. [NC]
#   RewriteRule ^ https://chametofficialagency.in%{REQUEST_URI} [L,R=301]
# </IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml text/xml text/plain image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
