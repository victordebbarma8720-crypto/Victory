# ==========================================================
# fonoapp.in - Apache / Hostinger configuration
# ==========================================================
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS + non-www (enable AFTER the SSL certificate is active in hPanel) ---
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteRule ^ https://fonoapp.in%{REQUEST_URI} [L,R=301]

  # /index.html -> /   and   /folder/index.html -> /folder/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]

  # Old-style addresses -> homepage sections (About Us / Contact are homepage sections)
  RewriteRule ^about-us/?$ /#about-us [NE,L,R=301]
  RewriteRule ^contact/?$ /#contact [NE,L,R=301]

  # Common alternative spellings
  RewriteRule ^fono-host/?$ /fono-hosting/ [L,R=301]
  RewriteRule ^privacy-policy/?$ /privacy-policy.html [L,R=301]
  RewriteRule ^terms-and-conditions/?$ /terms-and-conditions.html [L,R=301]
  RewriteRule ^disclaimer/?$ /disclaimer.html [L,R=301]
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

# --- Browser caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
